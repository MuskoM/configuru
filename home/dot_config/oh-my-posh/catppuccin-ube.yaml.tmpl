# yaml-language-server: $schema=https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json
final_space: true
version: 3
blocks:
  - type: prompt
    alignment: left
    segments:
      - type: os
        style: diamond
        trailing_diamond: ""
        leading_diamond: ""
        template: "{{ "{{.Icon}}" }}"
        foreground: "{{ .ube.crust }}"
        background: "{{ .ube.accent }}"

      - type: git
        style: diamond
        trailing_diamond: ""
        foreground: "{{ .ube.crust }}"
        background: "{{ .ube.blue }}"
 
      - type: project
        style: powerline
        powerline_symbol: ""
        foreground: "{{ .ube.crust }}"
        background: "{{ .ube.amber }}"

      # Languages
      - type: lua
        style: powerline
        powerline_symbol: ""
        foreground: "{{ .ube.crust }}"
        background: "{{ .ube.blue }}"
      - type: node
        style: powerline
        powerline_symbol: ""
        foreground: "{{ .ube.crust }}"
        background: "{{ .ube.amber }}"
      - type: python
        style: powerline
        powerline_symbol: ""
        foreground: "{{ .ube.crust }}"
        background: "{{ .ube.lime }}"
      - type: rust
        style: powerline
        powerline_symbol: ""
        foreground: "{{ .ube.crust }}"
        background: "{{ .ube.amber }}"
      - type: go
        style: powerline
        powerline_symbol: ""
        foreground: "{{ .ube.crust }}"
        background: "{{ .ube.blue }}"

      - type: path
        style: diamond
        trailing_diamond: ""
        foreground: "{{ .ube.crust }}"
        background: "{{ .ube.pink }}"
        properties:
          style: folder
          home_icon: 
          folder_icon: 󰉋
          mapped_locations_enabled: true
          mapped_locations: 
            ~/Configurations/configuru : 󰙵
      ### 
