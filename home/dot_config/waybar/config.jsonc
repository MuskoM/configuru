{
    "layer" : "top",
    "modules-left": [ "niri/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "battery"],
    "clock": {
        "format": "󰃭 {:%d - %H:%M}"
    },
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "gaming": "󰊴",
            "steam": "",
            "urgent": "",
            "active": "",
            "default": ""
        }
    },
    "niri/window": {
        "separate-outputs": true,
        "rewrite": {
            "(.*) - Brave": "$1"
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "alsa_output.usb-Generic_USB_Audio-00.HiFi__Speaker__sink": "󰓃",
            "alsa_output.usb-SteelSeries_Arctis_Nova_Pro_Wireless-00.pro-output-0": "",
            "headphone": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },
}
